# YouTube Data API v3 key (OPTIONAL)
# Leave blank to fall back to yt-dlp for playlist metadata (no key required).
# Get a free key: https://console.cloud.google.com/ -> enable "YouTube Data API v3"
youtube_api_key = ""

# Server-side YouTube cookies (OPTIONAL, operators only)
# Reduces IP rate-limiting on shared hosts. Copy the Cookie header value from a
# logged-in browser session. NEVER ask public users to paste their own cookies.
# youtube_cookies = "VISITOR_INFO1_LIVE=...; CONSENT=...;"
